LANGSMITH_PROJECT="banking-concierge"
LANGSMITH_TRACING="true"
# Emit traces via the OpenTelemetry SDK (exported to LangSmith's OTLP endpoint)
# instead of the native LangSmith run-tree client.
LANGSMITH_OTEL_ENABLED="true"
LANGSMITH_OTEL_ONLY="true"
# The langsmith SDK posts to `{endpoint}/otel` (a 404), so give the full OTLP
# traces URL. Setting HEADERS replaces the SDK defaults, so it must carry the
# API key and project, plus X-Tenant-Id for org-scoped keys (else spans are
# silently dropped). Fill in the <...> values with the ones below.
OTEL_EXPORTER_OTLP_ENDPOINT="https://api.smith.langchain.com/otel/v1/traces"
OTEL_EXPORTER_OTLP_HEADERS="x-api-key=<LANGSMITH_API_KEY>,Langsmith-Project=banking-concierge,X-Tenant-Id=<LANGSMITH_WORKSPACE_ID>"

LANGSMITH_WORKSPACE_ID=""
LANGSMITH_API_KEY=""
BASE_URL="https://gateway.smith.langchain.com/openai/v1"

OPENAI_API_KEY=""

# Optional override; defaults to gpt-4o-mini for the agent
CONCIERGE_MODEL="gpt-4o-mini"

# Only needed for scripts/load_generation.py --mode remote
LANGGRAPH_DEPLOYMENT_URL=""
